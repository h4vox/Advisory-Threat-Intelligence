#!/bin/sh
# Fallback Antigravity CLI (`agy`) shim.
#
# The image installs the real CLI from Google's official installer at build time (see Dockerfile).
# This shim is what remains when that install could not run (no network while building), so the
# image still builds and the container still starts. AIE recognises it by its empty `--version`,
# reports the agent as not installed and rebuilds the image from the Marketplace.

case "$1" in
  --version | -v | version)
    # The runtime treats empty output as "agy unavailable" and routes to a direct provider.
    exit 0
    ;;
esac

# Any real invocation: emit a structured, parseable notice on stderr and exit non-zero so the caller
# cleanly falls back to a direct AI provider instead of hanging.
echo '{"error":"antigravity_cli_unavailable","message":"The Antigravity CLI (agy) is not installed in this sandbox image (the official installer could not run while the image was built). Install the agent again from the Marketplace with network access, or configure a direct AI provider (Gemini, Claude or OpenAI)."}' >&2
exit 127
