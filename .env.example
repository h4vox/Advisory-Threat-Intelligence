# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=threat-intel-DB
MONGODB_COLLECTION=threat-intel
PORT=8080

# Google Cloud OAuth 2.0 Credentials (AGY Marketplace Integration)
AGY_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
AGY_CLIENT_SECRET=your-google-oauth-client-secret
