# Copy these into your deployment's environment variables (or a local, untracked
# .env file). Values below are placeholders only; never commit real secrets.

# --- MongoDB (required) -------------------------------------------------------
# Connection string for the threat-intel database (your report library, sources,
# accounts). Without it the app runs on a built-in local database that starts
# empty and says so on the Overview and Library pages; there are no built-in
# credentials. For `npm run dev`, a .env file next to package.json is read.
#
# SHARED / PUBLIC DEPLOYMENT: set MONGODB_URI ONCE in your hosting platform's
# environment variables (e.g. Vercel → Settings → Environment Variables, for
# Production and Preview) and redeploy. Every visitor to the public URL then uses
# that same database — the library and data are shared for everyone. Do NOT commit
# the URI to the repository: it carries credentials, so anyone who can read the
# code could read, modify or delete the whole database. The deploy env is the
# right home for it; the repository must never hold it.
# Use the Atlas SRV string (mongodb+srv://...) or a standard mongodb:// URI.
# URL-encode special characters in the password (@ -> %40, / -> %2F).
# Networks that refuse SRV DNS lookups are handled: AIE then asks public DNS for
# the cluster's hosts and connects with the equivalent mongodb:// seed list.
MONGODB_URI=
# Example shape (do not use literally):
#   mongodb+srv://USER:PASSWORD@your-cluster.example.mongodb.net/?appName=YourApp
# Database / collection names (optional; defaults shown).
MONGODB_DATABASE=threat-intel-DB
MONGODB_COLLECTION=threat-intel

# --- Username and password sign-in ---------------------------------------------
# The administrator account is created on first start from these values and
# stored in MongoDB (collection aie_users) as an scrypt hash; the password itself
# is never stored. Without MONGODB_URI it lives in the local database instead.
# Changing AIE_ADMIN_PASSWORD later and restarting resets that account's password.
# The administrator can add more users in Settings > Users & access.
AIE_ADMIN_USERNAME=havox
AIE_ADMIN_PASSWORD=
# Optional email shown on the administrator's profile.
AIE_ADMIN_EMAIL=
# Temporary email + password account for development, usable right away (sign in with the email).
# Created/updated on start like the administrator; changing the password resets it. Admin role.
# Use this before full auth is wired up; remove both to delete the account on the next start.
DEV_USER_CRED_EMAIL=
DEV_USER_CRED_PASS=

# --- Sign-in mode -------------------------------------------------------------
# Single sign-on (Google / X) is OFF by default: sign-in is email/username +
# password only, and the app never redirects to Google. The switch is the build
# flag VITE_AUTH_ENABLED in .grok/app-env.json ("false" = password only, the
# default; "true" = also show SSO). It is baked at build time, so rebuild/redeploy
# after changing it, and make sure your host's env does not override it to "true".

# --- Single sign-on access control (only when VITE_AUTH_ENABLED=true) ----------
# Who may use single sign-on. Comma-separated. A user is allowed if their verified
# email is listed in AIE_ALLOWED_EMAILS or its domain is listed in
# AIE_ALLOWED_DOMAINS. In production at least one of these must be set, or single
# sign-on is refused (username and password accounts are not affected).
AIE_ALLOWED_EMAILS=
# e.g. AIE_ALLOWED_EMAILS=alice@example.com,bob@example.com
AIE_ALLOWED_DOMAINS=
# e.g. AIE_ALLOWED_DOMAINS=example.com

# --- AI providers (server-only; optional) -------------------------------------
# API keys used by the server for analysis. Leave blank to disable a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Google OAuth client (AGY Marketplace integration; optional) --------------
# OAuth 2.0 client for the built-in agent's optional Google sign-in. Leave blank
# and that sign-in is hidden (the Marketplace explains why) — it needs your OWN
# Google OAuth client id, not a shared one. The simpler path for AI is a direct
# provider API key above (e.g. GEMINI_API_KEY), which needs no Google sign-in.
AGY_OAUTH_CLIENT_ID=
AGY_OAUTH_CLIENT_SECRET=

PORT=8080
