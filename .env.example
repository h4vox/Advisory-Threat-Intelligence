# AIE configuration. Copy to `.env` next to package.json (untracked) or set these in the
# server's environment. Every value comes from here: nothing is built into the code.
# Values below are placeholders; never commit real secrets.

# --- Database (required) --------------------------------------------------------
# MongoDB holding the library, sources, settings and AI sessions. A mongodb:// or
# mongodb+srv:// URI; URL-encode special characters in the password (@ -> %40, / -> %2F).
# In production the app refuses to start without it. In development, leaving it unset
# (or MONGODB_URI=local) uses an empty built-in local database.
MONGODB_URI=mongodb://aie:<AIE_MONGO_PASSWORD>@127.0.0.1:27017/?authSource=admin
# Database / collection names (optional; defaults shown).
MONGODB_DATABASE=threat-intel-DB
MONGODB_COLLECTION=threat-intel

# --- Sign-in (required) ------------------------------------------------------------
# One username and password. Sign-in is refused until both are set.
AIE_ADMIN_USERNAME=
AIE_ADMIN_PASSWORD=
# Signs the sign-in cookie: a random string of 32+ characters
# (e.g. `openssl rand -base64 48`). Without it a random one is made at start, so
# everyone is signed out whenever the server restarts.
AIE_SESSION_SECRET=
# How long a sign-in lasts, in days (default 7).
AIE_SESSION_DAYS=7

# --- Serving -----------------------------------------------------------------------
# Production server (`npm run start:prod`, or startup.sh in production mode).
# Keep 127.0.0.1 behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel) that does TLS.
AIE_HOST=127.0.0.1
PORT=8080
# startup.sh: "production" (fast, built once) or "dev" (Vite dev server, live reload).
AIE_RUN_MODE=production
# Behind a reverse proxy on another machine, set AIE_TRUST_PROXY=1 so sign-in rate limiting
# sees real client addresses (X-Forwarded-For). A proxy on this machine is trusted automatically.
AIE_TRUST_PROXY=
# Public host names the dev/preview servers answer to, separated by commas (e.g.
# AIE_ALLOWED_HOSTS=havox.site,h4vox.site,example.org). A domain also covers
# its subdomains: AIE_ALLOWED_HOSTS=havox.site allows aie.havox.site. Restart after changing it.
# Not needed in production mode (AIE_RUN_MODE=production), which does not check the host.
AIE_ALLOWED_HOSTS=

# --- AI providers (server-only; optional) --------------------------------------
# API keys used by the server for analysis. Leave blank to disable a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Crawler web search (optional) ---------------------------------------------
# Engines are tried in this order. DuckDuckGo needs no key but often shows servers a bot
# check; the crawler then skips it for the run, and the AI agent suggests reports instead.
# A SearXNG instance with the JSON format enabled (self-hosted, free), e.g. http://127.0.0.1:8888
AIE_SEARXNG_URL=
# Brave Search API key (free tier available).
BRAVE_SEARCH_API_KEY=
# Set to 1 to stop using DuckDuckGo.
AIE_DISABLE_DUCKDUCKGO=

# --- Google OAuth client (agent's optional Google sign-in; optional) ------------
# Your own Google OAuth client for the built-in agent's Google sign-in. Leave blank and
# that sign-in is hidden. A provider API key above needs no Google sign-in.
AGY_OAUTH_CLIENT_ID=
AGY_OAUTH_CLIENT_SECRET=

# --- PostgreSQL (migration; docs/db-migration.md) -----------------------------------
# Local PostgreSQL started with docker-compose.db.yml. Used by `npm run db:migration`.
# POSTGRES_PASSWORD=<superuser password for the container>
# PG_ADMIN_URL=postgres://postgres:<superuser password>@127.0.0.1:5432/postgres
# AIE_DB_USER=aie
# AIE_DB_PASSWORD=<app role password, 16+ characters>
# AIE_INTEL_DATABASE_URL=postgres://aie:<app role password>@127.0.0.1:5432/aie_intel
# AIE_APP_DATABASE_URL=postgres://aie:<app role password>@127.0.0.1:5432/aie_app
# Source MongoDB for the migration (default: MONGODB_URI above):
# MIGRATION_MONGO_URI=
# MIGRATION_MONGO_DB=threat-intel-DB
